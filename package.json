{
  "name": "anecdotia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Anecdotia mini PWA pilot for family story capture.",
  "author": "Juan O",
  "homepage": "https://anecdotia.entitybuilders.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanobrach/entity-builders.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
